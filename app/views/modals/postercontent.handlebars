<div class="map-head">
  <h1>Les Foulées Sarmates 2026</h1>
  <h2>by Messe Basse Production</h2>
</div>
<div class="map-body">
  <img src="" id="trace-image">
  <img src="" id="back-image">
</div>
<div class="map-foot">
  <img src="/assets/img/logo/mbp-logo-black.png" class="mbp-logo">
  <h3 class="race-date">17 Octobre 2026</h3>
  <div class="left-end">
    <h3 id="race-name"></h3>
    <img src="" id="map-topology">
  </div>
  <div class="right-end">
    <h4>#<span id="runner-number"></span> – <span id="runner-surname"></span> <span id="runner-name"></span></h4>
    <div class="stats-wrapper">
      <div class="left-stat">
        <div class="metric">
          <p>Distance</p>
          <p id="race-distance"></p>
        </div>
        <div class="metric">
          <p>Dénivelé</p>
          <p id="race-elevation"></p>
        </div>
      </div>
      <div class="right-stat">
        <div class="metric">
          <p>Temps</p>
          <p id="race-time">1h13'45"</p>
        </div>
        <div class="metric">
          <p>Allure moyenne</p>
          <p id="race-pace">17/10/2026</p>
        </div>
      </div>
    </div>
  </div>
</div>
